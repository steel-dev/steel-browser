{
  "manifest_version": 3,
  "name": "Steel Recording Extension",
  "version": "2.0",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://0.0.0.0/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/inject.js"
      ]
    }
  ]
}
