{
  "name": "steel-browser",
  "version": "0.5.3",
  "private": true,
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "workspaces": [
    "api",
    "ui",
    "repl"
  ],
  "scripts": {
    "build": "npm run build -w api -w ui",
    "dev": "concurrently \"npm run dev -w api\" \"npm run dev -w ui\"",
    "test": "npm run test -w api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "concurrently": "^8.2.0",
    "lint-staged": "^16.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "api/src/**/*.ts": "prettier --write",
    "ui/src/**/*.{ts,tsx,css}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "fastify": "^5.2.1",
    "husky": "^9.1.7",
    "lodash-es": "^4.17.21"
  },
  "overrides": {
    "tar-fs": ">=3.1.1",
    "tar": "^7.5.22",
    "basic-ftp": "^6.2.3"
  }
}
