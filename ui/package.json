{
  "name": "@steel-browser/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host ${HOST:-0.0.0.0}",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "generate-api": "npx --yes --prefix=/ --package=typescript@5.9.2 --package=@hey-api/openapi-ts@0.99.0 openapi-ts -i ../api/openapi/schemas.json -o src/client -p @hey-api/typescript --no-log-file && prettier --write src/client"
  },
  "dependencies": {
    "@rrweb/packer": "2.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrweb": "2.1.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.2",
    "vite": "8.3.4"
  }
}
